# Copy to .env.sso-lab.local; run npm run dev:sso-lab.
# Disposable loopback test provider only; not a production SSO configuration.
# This selects endpoints. It does not start the provider/backend or create users.
VITE_API_URL=
CONTROL_ONE_API_URL=http://127.0.0.1:18448
CONTROL_ONE_AGENT_PUBLIC_URL=https://127.0.0.1:18443
VITE_LIVE_EVENTS_MODE=polling
VITE_OIDC_AUTH_URL=http://127.0.0.1:18447/authorize
VITE_OIDC_TOKEN_URL=http://127.0.0.1:18447/token
VITE_OIDC_CLIENT_ID=control-one-isolated-spa
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:4177/console/auth/callback
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_AUDIENCE=

# The complete provider runtime is not distributed by this example.
# Follow docs/control-one-organizational-sso-guide-2026-11-05.md.
# Credentials must be supplied through the provider's approved local setup.
# Never add passwords, tokens, client secrets or private keys to this template.
