# Copy to .env.local for normal local development. Never put secrets in VITE_*.
# Values with the VITE_ prefix are public browser configuration.
VITE_API_URL=
CONTROL_ONE_API_URL=http://127.0.0.1:8443
CONTROL_ONE_AGENT_PUBLIC_URL=https://127.0.0.1:18443
VITE_LIVE_EVENTS_MODE=polling

# Leave all three blank to disable organizational SSO in the frontend.
# Set them from an approved identity-provider application registration.
VITE_OIDC_AUTH_URL=
VITE_OIDC_TOKEN_URL=
VITE_OIDC_CLIENT_ID=
# Example only: https://console.example.invalid/console/auth/callback
# The registered redirect must match the actual UI origin and callback exactly.
# VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SCOPE=openid profile email controlone.access
# Optional provider-specific audience parameter; not an Entra API scope.
VITE_OIDC_AUDIENCE=

# Backend issuer/client/audience and role mappings are configured separately.
# No passwords, bearer tokens, private keys or client secrets belong here.
